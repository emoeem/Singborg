[Unit]
Description=sing-box DNS 看门狗（清除错误的否定缓存并自愈）
Documentation=https://github.com/emoeem/Singborg
# 排在 sing-box 之后：探测的是它提供的解析路径。不用 BindsTo/PartOf ——
# 自愈时要 stop/start 的正是它，绑在一起会把自己也带下去。
After=sing-box.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sing-box-dns-watchdog --heal

# 只清缓存、不写配置：整个文件系统只读，只放行 cache.db 与状态文件所在的目录。
# systemctl / resolvectl 走 D-Bus，不受这里限制。
ProtectSystem=strict
ReadWritePaths=/var/lib/sing-box
PrivateTmp=yes
NoNewPrivileges=yes

# 自愈失败时以非 0 退出是有意的：它会在 systemctl --failed 里露出来，
# 而不是安静地每 5 分钟重试一次。
